{
    "name": "andreapeverelli/phx-baselines",
    "description": "PHX framework baseline components.",
    "type": "framework",
    "license": "GPL-3.0",
	"version": "0.2.0",
    "autoload": {
        "psr-4": {
            "AndreaPeverelli\\PhxBaselines\\": [
				"src/",
				"src/heading/"
			]
        }
    },
    "authors": [
        {
            "name": "Andrea Peverelli",
			"email": "ndrpeverelli@gmail.com"
        }
    ],
	"minimum-stability": "stable",
	"scripts": {
		"test": "XDEBUG_MODE=coverage phpunit",
		"analyse": "phpstan analyse",
		"docs": "phpdoc",
		"lint": "php-cs-fixer check",
		"fix": "php-cs-fixer fix",
		"prepare": [
			"@fix",
			"@analyse",
			"@test",
			"@docs"
		]
	},
	"repositories": [
        {
            "type": "vcs",
            "url": "https:\/\/github.com\/andreapeverelli\/phx-core.git"
        }
	],
    "require-dev": {
        "phpunit/phpunit": "^13.3",
        "phpstan/phpstan": "^2.2",
        "phpdocumentor/shim": "^3.10",
        "friendsofphp/php-cs-fixer": "^3.95",
        "monolog/monolog": "^3.10"
    },
    "require": {
        "andreapeverelli/phx-core": "^0.2.1"
    },
    "config": {
        "allow-plugins": {
            "phpdocumentor/shim": true
        }
    }
}
